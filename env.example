# 命令列 scripts/probe_flowchart.py 必填這三個。網頁不讀金鑰，也不讀 MODEL。
OPENAI_BASE_URL=https://<閘道>/v1
OPENAI_API_KEY=
MODEL=

# 網頁上的兩列就叫 INNER、PORTAL。這裡只改網址；金鑰在頁面填，不要寫進這個檔。
# INNER_BASE_URL=https://inner-medusa.genai.nchc.org.tw/v1
# PORTAL_BASE_URL=https://portal.genai.nchc.org.tw/api/v1

# 契約在 configs/models/*.json（對齊官網，不是閘道枚舉）
# shell 已 export 的同名變數會蓋過本檔。

# PROBE_SCOPE=official   # 預設：官方特殊參數＋文件寫死的回覆欄位
# PROBE_SCOPE=full       # A–F 通用考卷 + 契約槍
# PROBE_MODE=probe       # 預設：打閘道
# PROBE_MODE=enforce     # 官方不允許就本機 400

# REASONING_EFFORT=      # 空白＝該 Profile 官方枚舉；未知模型則不掃
# STREAM_STEPS=          # 不設＝僅 D/F 串流；true＝全部串流；false＝全關
#                        # official 契約槍一律非串流
# ENABLE_THINKING=       # 舊變數，命令列會略過。Gemma 的開關在契約裡
# VLLM_BASE_URL=         # 直連 vLLM 根網址（不是閘道 /v1）。有開 VLLM_SERVER_DEV_MODE=1 才讀得到 parser 旗標
# LITELLM_REQUEST_DEBUG= # true＝每槍加 litellm_request_debug；轉發 body 在 Proxy 日誌，用 x-litellm-call-id 對

# Kimi K3：configs/models/kimi-k3.json
# Gemma 4：configs/models/gemma-4.json（官方只有 enable_thinking 開／關）
# 其他 family：configs/models/README.md
# Gemma × Kimi 人讀：PARAMS.md
