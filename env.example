OPENAI_BASE_URL=https://<閘道>/v1
OPENAI_API_KEY=
MODEL=

# ── 依 MODEL 建議 env（對齊官網，非閘道枚舉）────────────────────────────────
# Kimi K3：  REASONING_EFFORT=low,high,max（不用 ENABLE_THINKING）
#   https://platform.kimi.ai/docs/guide/use-reasoning-effort
#   https://platform.kimi.ai/docs/api/models-overview
# Gemma 4：  REASONING_EFFORT=low,medium,high,none ＋ 視模型 ENABLE_THINKING=true
#   https://ai.google.dev/gemma/docs/core/model_card_4
#   https://docs.vllm.ai/en/latest/features/reasoning_outputs/
# 本專案對照表 → PARAMS.md

# 可選 REASONING_EFFORT：A 步驟要掃的 reasoning_effort（逗號分隔）
#   不設／空白 → 腳本掃 low,medium,high,max,none（探測聯集，比官網枚舉還寬）
#   閘道 200 不代表官方有該檔；看結果 JSON 的 compare.vs_default
# REASONING_EFFORT=low,medium,high,none

# 可選 ENABLE_THINKING（僅 Gemma 4）：true＝每槍帶 chat_template_kwargs.enable_thinking=true
#   不設／false → 不帶此欄位
#   https://docs.vllm.ai/projects/recipes/en/stable/Google/Gemma4.html
# ENABLE_THINKING=true
