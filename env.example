OPENAI_BASE_URL=https://<閘道>/v1
OPENAI_API_KEY=
MODEL=

# 契約在 configs/models/*.json（對齊官網，不是閘道枚舉）
# 複製本檔為 .env 後填三個必填欄。shell 已 export 的同名變數會蓋過本檔。

# PROBE_SCOPE=official   # 預設：官方特殊參數＋文件寫死的回覆欄位
# PROBE_SCOPE=full       # A–F 通用考卷 + 契約槍
# PROBE_MODE=probe       # 預設：打閘道
# PROBE_MODE=enforce     # 官方不允許就本機 400

# REASONING_EFFORT=      # 空白＝該 Profile 官方枚舉；未知模型則不掃
# STREAM_STEPS=          # 不設＝僅 D/F 串流；true＝全部串流；false＝全關
#                        # official 契約槍一律非串流
# ENABLE_THINKING=       # 已忽略。Gemma 由 Profile flag 產生獨立對照槍

# Kimi K3：configs/models/kimi-k3.json
# Gemma 4：configs/models/gemma-4.json（官方只有 enable_thinking 開／關）
# 其他 family：configs/models/README.md
# Gemma × Kimi 人讀：PARAMS.md
