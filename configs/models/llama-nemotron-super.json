{
  "id": "llama-nemotron-super",
  "family": "NVIDIA Llama-3.3 Nemotron Super",
  "known": true,
  "transport": "openai_chat",
  "baseline": true,
  "note": "NVIDIA 官方用 system prompt「detailed thinking on／off」開關，不是 Nemotron 3 的 reasoning_effort。本引擎不探測 system prompt，故 params 為空、只跑 baseline。",
  "source": [
    "https://docs.nvidia.com/nim/large-language-models/1.13.0/reasoning-model.html"
  ],
  "match": {
    "id_prefix": [
      "llama-3.3-nemotron-super"
    ]
  },
  "request_defaults": {
    "length_param": "max_tokens",
    "max_output": 1024
  },
  "params": []
}
