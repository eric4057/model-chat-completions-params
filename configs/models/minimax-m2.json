{
  "id": "minimax-m2",
  "family": "MiniMax M2.x",
  "known": true,
  "transport": "openai_chat",
  "baseline": true,
  "note": "M2.x 官方 thinking.type 只有 adaptive／disabled。disabled 會被接受但思考仍開，不是 4xx。沒有 enabled。",
  "source": [
    "https://platform.minimax.io/docs/api-reference/text-chat-openai"
  ],
  "match": {
    "id_prefix": [
      "minimax-m2"
    ]
  },
  "request_defaults": {
    "length_param": "max_completion_tokens",
    "max_output": 1024
  },
  "sampling": [
    {
      "name": "temperature",
      "default": 1,
      "adjustable": false,
      "note": ""
    },
    {
      "name": "top_p",
      "default": 0.95,
      "adjustable": false,
      "note": ""
    }
  ],
  "params": [
    {
      "name": "thinking.type",
      "kind": "enum",
      "values": [
        "adaptive",
        "disabled"
      ],
      "default": "adaptive",
      "effect": "has_reasoning",
      "can_disable": false,
      "note": "disabled 官方仍開 thinking，不列入 disable_values"
    },
    {
      "name": "assistant_echo",
      "kind": "echo",
      "effect": "http_ok"
    }
  ]
}
