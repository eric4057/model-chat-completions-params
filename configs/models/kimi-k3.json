{
  "id": "kimi-k3",
  "family": "Moonshot Kimi K3",
  "known": true,
  "transport": "openai_chat",
  "baseline": true,
  "note": "thinking 永遠開；temperature/top_p 官方固定；長度欄用 max_completion_tokens",
  "source": [
    "https://platform.kimi.ai/docs/guide/use-reasoning-effort",
    "https://platform.kimi.ai/docs/api/models-overview",
    "https://platform.kimi.ai/docs/guide/kimi-k3-quickstart"
  ],
  "match": {
    "id_equals": [
      "kimi-k3",
      "moonshot/kimi-k3"
    ],
    "id_prefix": [
      "kimi-k3"
    ]
  },
  "request_defaults": {
    "length_param": "max_completion_tokens",
    "max_output": 1024
  },
  "params": [
    {
      "name": "reasoning_effort",
      "kind": "enum",
      "values": [
        "low",
        "high",
        "max"
      ],
      "default": "max",
      "reject": [
        "none",
        "medium"
      ],
      "invalid_example": "not-a-level",
      "effect": "reasoning_tokens_rank",
      "can_disable": false,
      "note": "官方 low/high/max，預設 max；無 none/medium"
    },
    {
      "name": "thinking",
      "kind": "forbidden",
      "probe_value": {
        "type": "enabled"
      },
      "note": "K2.x 物件；K3 不要傳"
    },
    {
      "name": "temperature",
      "kind": "locked",
      "locked_value": 1.0,
      "probe_value": 0.2
    },
    {
      "name": "top_p",
      "kind": "locked",
      "locked_value": 0.95,
      "probe_value": 0.1
    },
    {
      "name": "assistant_echo",
      "kind": "echo",
      "effect": "http_ok",
      "note": "多輪須回傳完整 assistant（含 reasoning_content）"
    }
  ],
  "official_examples": [
    {
      "id": "reasoning-effort-high",
      "source": "https://platform.kimi.ai/docs/guide/use-reasoning-effort",
      "prompt": "Derive the general formula for this sequence: 1, 4, 9, 25, 64, ...",
      "request": {
        "reasoning_effort": "high"
      },
      "docs_quote": "K3 top-level reasoning_effort; print reasoning_content then content",
      "expect": {
        "http": 200,
        "message_fields": ["content", "reasoning_content"]
      }
    }
  ]
}
