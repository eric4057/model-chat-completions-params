{
  "id": "minimax-m3",
  "family": "MiniMax M3",
  "known": true,
  "transport": "openai_chat",
  "baseline": true,
  "note": "只對 MiniMax-M3，不含 M3.1-Flash。thinking.type 官方是 adaptive（預設）與 disabled；disabled 會直接回答。沒有 enabled。reasoning_split 只改回傳欄位。",
  "source": [
    "https://platform.minimax.io/docs/api-reference/text-chat-openai"
  ],
  "match": {
    "id_prefix": [
      "minimax-m3"
    ]
  },
  "request_defaults": {
    "length_param": "max_completion_tokens",
    "max_output": 1024
  },
  "sampling": [
    {
      "name": "temperature",
      "default": 1,
      "adjustable": false,
      "note": ""
    },
    {
      "name": "top_p",
      "default": 0.95,
      "adjustable": false,
      "note": ""
    }
  ],
  "params": [
    {
      "name": "thinking.type",
      "kind": "enum",
      "values": [
        "adaptive",
        "disabled"
      ],
      "default": "adaptive",
      "disable_values": [
        "disabled"
      ],
      "invalid_example": "not-a-level",
      "effect": "has_reasoning",
      "can_disable": true,
      "note": "省略時預設 adaptive；disabled 關閉思考"
    },
    {
      "name": "reasoning_split",
      "kind": "flag",
      "default": false,
      "true_effect": "has_reasoning",
      "false_effect": null,
      "note": "只改回傳欄位，不開關 thinking"
    },
    {
      "name": "assistant_echo",
      "kind": "echo",
      "effect": "http_ok",
      "note": "多輪須回傳 reasoning_content / reasoning_details"
    }
  ]
}
